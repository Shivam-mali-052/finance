rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // 1. User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.displayName is string && data.displayName.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               data.createdAt is string &&
               data.keys().hasAll(['displayName', 'email', 'createdAt']) &&
               data.keys().size() == 3;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
    }

    // 2. Transaction Rules
    match /transactions/{transactionId} {
      function isValidTransaction(data) {
        return data.type in ['income', 'expense'] &&
               data.amount is number && data.amount >= 0 &&
               data.category is string && data.category.size() <= 50 &&
               data.date is timestamp &&
               data.userId == request.auth.uid &&
               data.description is string && data.description.size() <= 200 &&
               data.keys().hasAll(['type', 'amount', 'category', 'date', 'userId', 'createdAt', 'description']) &&
               data.keys().size() == 7;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidTransaction(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'date', 'description']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // 3. Budget Rules
    match /budgets/{budgetId} {
      function isValidBudget(data) {
        return data.monthlyLimit is number && data.monthlyLimit >= 0 &&
               data.month is string && data.month.size() <= 10 &&
               data.userId == request.auth.uid &&
               data.updatedAt is string &&
               data.keys().hasAll(['monthlyLimit', 'month', 'userId', 'updatedAt']) &&
               data.keys().size() == 4;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBudget(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidBudget(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['monthlyLimit', 'updatedAt']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
