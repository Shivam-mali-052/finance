{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or Expense record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["type", "amount", "category", "date", "userId"]
    },
    "Budget": {
      "title": "Monthly Budget",
      "description": "User set budget for a specific month",
      "type": "object",
      "properties": {
        "monthlyLimit": { "type": "number" },
        "month": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["monthlyLimit", "month", "userId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Individual income and expense entries"
    },
    "budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Monthly budget settings"
    }
  }
}
